<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.1.0</Version>
    <AssemblyName>fed-protect</AssemblyName>
    <Authors>seloc0des</Authors>
    <Description>CLI for FEDProtect - protect protesters from surveillance</Description>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.47.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    <PackageReference Include="YamlDotNet" Version="13.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FEDProtect.Core\FEDProtect.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\profiles\**\*.yaml" CopyToOutputDirectory="PreserveNewest" LinkBase="profiles" />
  </ItemGroup>

</Project>
